include README.md
include license
include pyproject.toml
include requirements.txt

recursive-include src/DeepGPR *.py *.typed *.cu *.h *.c *.dll *.so *.dylib

# Exclude local state and repository-only resources.
prune .*
prune validation
prune docs
prune examples
prune tests
prune website

# Keep the relocated manifest and its build hook available in the sdist.
include docs/MANIFEST.in
include docs/build_support.py
include docs/CHANGELOG.md
recursive-include docs/Fig *.png

global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude __pycache__
